# DMR (Don't Merge without Review) Configuration Example
# Copy this file to .env and fill in your actual values
# IMPORTANT: Never commit .env file with real credentials!

# ===========================
# Server Configuration
# ===========================
SERVER_PORT=8080

# ===========================
# AI Provider Configuration
# ===========================
# AI Provider: openai (VLLM, OpenAI, Ollama) or anthropic (Claude)
AI_PROVIDER=openai

# ===========================
# vLLM / OpenAI-compatible API
# ===========================
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=EMPTY
VLLM_MODEL=deepseek-ai/DeepSeek-V3

# ===========================
# Anthropic Claude API
# ===========================
# Get API key from: https://console.anthropic.com/
CLAUDE_API_KEY=sk-ant-YOUR_CLAUDE_API_KEY_HERE
CLAUDE_MODEL=claude-sonnet-4-5-20250929
# Available models:
# - claude-sonnet-4-5-20250929 (Latest, best for coding and agents - Recommended)
# - claude-3-5-sonnet-20241022 (Previous stable version)
# - claude-3-5-haiku-20241022 (Faster, lower cost)
# - claude-3-opus-20240229 (Claude 3 series, higher cost)

# ===========================
# GitLab Configuration
# ===========================
# GitLab instance URL
GITLAB_URL=https://gitlab.example.com

# Personal Access Token with api scope
# Generate at: GitLab -> User Settings -> Access Tokens
GITLAB_TOKEN=glpat-YOUR_GITLAB_TOKEN_HERE

# Webhook secret token for security
# Use a strong random string (e.g., openssl rand -hex 32)
GITLAB_WEBHOOK_SECRET=your-webhook-secret-token-here

# ===========================
# Google Chat Configuration
# ===========================
# Google Chat webhook URL for notifications
# Get from: Google Chat -> Space -> Apps & integrations -> Webhooks
GOOGLE_CHAT_WEBHOOK_URL=https://chat.googleapis.com/v1/spaces/YOUR_SPACE_ID/messages?key=YOUR_KEY&token=YOUR_TOKEN

# Enable/disable Google Chat notifications
GOOGLE_CHAT_ENABLED=true

# ===========================
# Logging (Optional)
# ===========================
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_DMR=DEBUG
